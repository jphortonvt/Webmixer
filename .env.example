# Copy to .env and fill in. Never commit the real .env.

# --- Server ---
PORT=3000
CACHE_DIR=./cache
SONGS_CACHE_DIR=./songs-cache

# Required in production (NODE_ENV=production) — the server refuses to start
# without it. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated origins allowed to call the API cross-origin.
# Leave unset for same-origin only (the normal setup).
# ALLOWED_ORIGINS=https://mixer.example.com

# --- Startup precache ---
# How many of the most recent sessions to transcode/warm at boot.
# Older sessions transcode on first open instead. 0 disables warming.
PRECACHE_RECENT_COUNT=5
# How many sessions to warm in parallel.
PRECACHE_CONCURRENCY=2

# --- Backblaze B2 (S3-compatible) ---
B2_ENDPOINT=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=

# --- Google OAuth ---
# Leave GOOGLE_CLIENT_ID empty to run in dev mode (auto-login as admin).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
ADMIN_EMAIL=
